# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# player database and imported inventory exports (see src/lib/db/client.ts)
/data

# a GOOD export is personal inventory data; belt and braces if one lands elsewhere
*.GOOD
genshinData_GOOD_*.json
e2e/.tmp/
.next-e2e/
# any other distDir (NEXT_DIST_DIR): Tailwind scans what git does not ignore,
# and a Turbopack cache read as source breaks the stylesheet
.next-*/
test-results/
playwright-report/

# WSL writes one of these next to every file copied in from Windows
*:Zone.Identifier

# agent skills are vendored and pinned by skills-lock.json, so they are
# committed; per-person permissions are not
.claude/settings.local.json
